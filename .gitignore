# 依赖：由 npm install 生成（仅 test/render-test.js 需要 jsdom）
node_modules/

# 打包 / 压缩产物
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# 日志与缓存
*.log
npm-debug.log*
.npm/
.cache/

# 本地配置与密钥（连 FHIR 服务端时勿提交真实凭据）
.env
.env.*
*.pem
*.key

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 派生产物：由 npm run seed:export / scripts/demo_data.py 生成，不是数据源
build/
__pycache__/
*.pyc
